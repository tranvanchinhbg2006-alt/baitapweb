@{
    ViewData["Title"] = "Bai 1";

    DateTime today = DateTime.Today;
    bool isWeekend = today.DayOfWeek == DayOfWeek.Saturday ||
                     today.DayOfWeek == DayOfWeek.Sunday;
}

<h1>Bai 1 - Kiem tra cuoi tuan</h1>

<p>Hom nay: <strong>@today.ToString("dd/MM/yyyy")</strong></p>

<div class="result">
    @if (isWeekend)
    {
        <strong>Hom nay la cuoi tuan.</strong>
    }
    else
    {
        <strong>Hom nay khong phai la cuoi tuan.</strong>
    }
</div>
